<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.quanxiaoha.xiaohashu.comment.biz.domain.mapper.CommentCountEventMapper">
  <select id="selectAppliedDelta" resultType="int">
    SELECT applied_delta FROM t_comment_count_event
    WHERE event_id = #{eventId} AND counter_type = #{counterType}
  </select>
</mapper>
